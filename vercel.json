{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/soundboard/", "permanent": false }, { "source": "/soundboard", "destination": "/soundboard/", "permanent": true }],
  "headers": [
    { "source": "/soundboard/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/soundboard/" }] },
    { "source": "/soundboard/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
